# App & Server Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com
ALLOWED_ORIGIN=https://your-domain.com

# Master Secrets Encryption Key (AES-256-GCM 32-byte hex string or 32+ char phrase)
SECRETS_MASTER_KEY=your_32_byte_aes_gcm_master_secret_key_hex_here

# Firebase Configuration
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
FIRESTORE_DATABASE_ID=(default)

# Firebase Admin SDK (Server Service Account - JSON string or path)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Platform AI Provider Keys (platform-owned, tenants never set or see these)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Email Infrastructure: Solicited Lane (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
# Outbound email via Resend: RESEND_FROM must be on a domain verified in Resend (SPF/DKIM)
RESEND_FROM=Sales <sales@yourdomain.com>
# Replies go here (the mailbox polled over IMAP). Defaults to SMTP_USER/IMAP_USER
RESEND_REPLY_TO=
# Set to 'smtp' to force SMTP even when Resend is configured
EMAIL_PROVIDER=
# Set to 'true' to never fall back to SMTP when Resend rejects an email
RESEND_DISABLE_SMTP_FALLBACK=
RESEND_WEBHOOK_SECRET=whsec_your_resend_svix_signing_secret_here

# Meta WhatsApp Webhook Fallback Verification
META_WEBHOOK_VERIFY_TOKEN=your-random-meta-verify-token-here

# Instagram Messaging API (Meta Developer App)
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=https://your-domain.com/api/instagram/oauth/callback
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0
INSTAGRAM_AI_MODEL=gpt-4o-mini

# Outlook / Microsoft 365 inbound mailbox ("Sign in with Microsoft")
# See MICROSOFT_IMAP.md for full Entra setup. Required for Settings → Inbound → Outlook.
# Entra app registration: supported account types = any organizational directory + personal Microsoft accounts.
# Redirect URI (Web): https://your-domain.com/api/oauth/microsoft/callback
# API permissions (delegated): Office 365 Exchange Online -> IMAP.AccessAsUser.All, plus offline_access, openid, email, profile
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: defaults to ${APP_URL}/api/oauth/microsoft/callback and "common"
MICROSOFT_REDIRECT_URI=
MICROSOFT_AUTH_TENANT=common

# Serverless / Vercel: secret for /api/inbound-mail/cron (polls every connected Gmail, Microsoft, and IMAP mailbox).
# Long-running `npm start` already polls every 30s and does not need this.
CRON_SECRET=

# Legacy Umrah360 Fallback SMTP (optional platform fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Per-workspace sending domains: comma-separated tenant ids that may keep sending from RESEND_FROM
# until they verify their own domain (e.g. PLATFORM_SENDER_TENANTS=umrah360). All other workspaces are
# blocked from sending until their domain is verified in Settings -> Email.
PLATFORM_SENDER_TENANTS=

# The shared IMAP mailbox (IMAP_*/SMTP_* above) belongs to ONE workspace. Only it can poll or view that mailbox.
IMAP_OWNER_TENANT_ID=umrah360

# --- Billing (Stripe) ---
# Use TEST keys while in the sandbox. Webhook endpoint: https://<your-domain>/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: where Stripe sends customers back to (defaults to the request origin)
APP_URL=
# Days a workspace keeps access after a failed payment before being locked (default 7)
BILLING_GRACE_DAYS=7
