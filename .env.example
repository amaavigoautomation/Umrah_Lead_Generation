# Firebase / Firestore Configuration (Auto-configured with built-in fallbacks, but can be customized)
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0376069258
VITE_FIREBASE_API_KEY=AIzaSyAcr6lIIH50XWD7CcmclWh9lxbPKO7TzBk
FIREBASE_PROJECT_ID=gen-lang-client-0376069258
FIREBASE_API_KEY=AIzaSyAcr6lIIH50XWD7CcmclWh9lxbPKO7TzBk
FIRESTORE_DATABASE_ID=ai-studio-379c884e-3360-468a-ad55-8105acbd3214

# OPENAI_API_KEY: Required for OpenAI AI model calls (e.g. gpt-4o-mini, gpt-4o).
# Configure this in your Vercel Project Settings -> Environment Variables.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# GEMINI_API_KEY: Fallback AI provider.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Configuration: Required for sending live outgoing auto-replies to customer emails.
# e.g. smtp.gmail.com, mail.amaavigo.com, smtp.titan.email, smtp.mailgun.org, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=amaavigo@gmail.com
SMTP_PASS=
SMTP_FROM="Umrah360 Automation <amaavigo@gmail.com>"

# IMAP Configuration: Required for reading live incoming emails arriving at automation@amaavigo.com
# e.g. imap.gmail.com, mail.amaavigo.com, imap.titan.email, etc.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=amaavigo@gmail.com
IMAP_PASS=

# Meta WhatsApp Cloud API (Required to connect physical WhatsApp messages sent to +919820252434)
# Register at developers.facebook.com -> WhatsApp -> API Setup
# Webhook URL: https://<YOUR_DEPLOYED_URL>/api/inbound/whatsapp
# Verify Token: umrah360_webhook_token
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=umrah360_webhook_token
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Meta Official Variable Names
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=umrah360_webhook_token

# Alternative WhatsApp Gateway: Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

