{
  "entities": {
    "Contact": {
      "title": "Contact",
      "description": "Pilgrimage agency contact profile",
      "type": "object",
      "properties": {
        "contactId": { "type": "string", "maxLength": 128 },
        "firstName": { "type": "string", "maxLength": 128 },
        "lastName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "companyName": { "type": "string", "maxLength": 256 },
        "jobTitle": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastActivityAt": { "type": "string" }
      },
      "required": ["contactId", "firstName", "email", "companyName"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Qualified tour operator lead record",
      "type": "object",
      "properties": {
        "leadId": { "type": "string", "maxLength": 128 },
        "contactId": { "type": "string", "maxLength": 128 },
        "source": { "type": "string", "enum": ["WEBSITE", "WHATSAPP", "INSTAGRAM", "FACEBOOK", "LINKEDIN", "EMAIL", "APOLLO"] },
        "leadType": { "type": "string", "enum": ["INBOUND", "OUTBOUND"] },
        "status": { "type": "string" },
        "leadScore": { "type": "number" },
        "intent": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "buyingStage": { "type": "string", "enum": ["AWARENESS", "CONSIDERATION", "DECISION", "PURCHASE"] },
        "serviceInterest": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["leadId", "contactId", "source", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Cross-channel conversation session",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "maxLength": 128 },
        "contactId": { "type": "string", "maxLength": 128 },
        "leadId": { "type": "string", "maxLength": 128 },
        "channel": { "type": "string", "enum": ["WEBSITE", "WHATSAPP", "INSTAGRAM", "FACEBOOK", "LINKEDIN", "EMAIL"] },
        "direction": { "type": "string", "enum": ["INBOUND", "OUTBOUND"] },
        "status": { "type": "string" },
        "aiEnabled": { "type": "boolean" },
        "humanHandoff": { "type": "boolean" },
        "managementMode": { "type": "string", "enum": ["AI", "HUMAN"] },
        "emailThreadId": { "type": "string", "maxLength": 128 },
        "gmailThreadId": { "type": "string", "maxLength": 256 },
        "isRead": { "type": "boolean" },
        "unread": { "type": "boolean" },
        "unreadCount": { "type": "number" },
        "startedAt": { "type": "string" },
        "lastMessageAt": { "type": "string" },
        "lastMessageText": { "type": "string", "maxLength": 4096 }
      },
      "required": ["conversationId", "contactId", "channel", "direction"]
    },
    "Message": {
      "title": "Message",
      "description": "Conversation message record",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "channel": { "type": "string" },
        "senderType": { "type": "string", "enum": ["CUSTOMER", "PROSPECT", "AI", "AGENT", "HUMAN"] },
        "senderName": { "type": "string", "maxLength": 128 },
        "senderEmail": { "type": "string", "maxLength": 256 },
        "text": { "type": "string", "maxLength": 8192 },
        "timestamp": { "type": "string" },
        "gmailMessageId": { "type": "string", "maxLength": 256 },
        "gmailThreadId": { "type": "string", "maxLength": 256 },
        "direction": { "type": "string", "enum": ["INBOUND", "OUTBOUND"] },
        "sentAt": { "type": "string" },
        "receivedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "aiProcessed": { "type": "boolean" },
        "confidence": { "type": "number" }
      },
      "required": ["messageId", "conversationId", "senderType", "text"]
    },
    "LeadActivity": {
      "title": "LeadActivity",
      "description": "Audit and timeline activity item",
      "type": "object",
      "properties": {
        "activityId": { "type": "string", "maxLength": 128 },
        "leadId": { "type": "string", "maxLength": 128 },
        "contactId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string" },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024 },
        "timestamp": { "type": "string" }
      },
      "required": ["activityId", "leadId", "title", "timestamp"]
    },
    "ProcessedInboundEmail": {
      "title": "ProcessedInboundEmail",
      "description": "Cross-session and cross-restore persistent email idempotency ledger to prevent duplicate outbound replies",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "maxLength": 512 },
        "cleanKey": { "type": "string", "maxLength": 512 },
        "fromEmail": { "type": "string", "format": "email", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 512 },
        "aiReplied": { "type": "boolean" },
        "repliedAt": { "type": "string" },
        "replyMessageId": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["PROCESSED", "REPLIED", "SKIPPED", "BASELINE"] },
        "reason": { "type": "string", "maxLength": 512 },
        "timestamp": { "type": "string" }
      },
      "required": ["messageId", "status", "timestamp"]
    },
    "EmailTemplate": {
      "title": "EmailTemplate",
      "description": "Predefined outbound email templates with variable substitution, styling, HTML, and attachments",
      "type": "object",
      "properties": {
        "templateId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 512 },
        "body": { "type": "string", "maxLength": 65536 },
        "htmlBody": { "type": "string", "maxLength": 65536 },
        "format": { "type": "string", "enum": ["text", "html"] },
        "isHtml": { "type": "boolean" },
        "attachments": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["templateId", "name", "subject", "body"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Outbound sales campaign record",
      "type": "object",
      "properties": {
        "campaignId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "type": { "type": "string", "enum": ["EMAIL", "WHATSAPP", "WHATSAPP_EMAIL"] },
        "status": { "type": "string", "enum": ["DRAFT", "RUNNING", "PAUSED", "COMPLETED", "FAILED"] },
        "templateId": { "type": "string", "maxLength": 128 },
        "templateName": { "type": "string", "maxLength": 256 },
        "sourceFileName": { "type": "string", "maxLength": 256 },
        "totalLeads": { "type": "number" },
        "sentCount": { "type": "number" },
        "pendingCount": { "type": "number" },
        "failedCount": { "type": "number" },
        "repliedCount": { "type": "number" },
        "demoBookedCount": { "type": "number" },
        "currentRunId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["campaignId", "name", "type", "status"]
    },
    "CampaignLead": {
      "title": "CampaignLead",
      "description": "Lead member uploaded and linked to an outbound campaign",
      "type": "object",
      "properties": {
        "campaignLeadId": { "type": "string", "maxLength": 128 },
        "campaignId": { "type": "string", "maxLength": 128 },
        "leadId": { "type": "string", "maxLength": 128 },
        "campaignRunId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "companyName": { "type": "string", "maxLength": 256 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "designation": { "type": "string", "maxLength": 128 },
        "sourceFile": { "type": "string", "maxLength": 256 },
        "rowNumber": { "type": "number" },
        "sendStatus": { "type": "string", "enum": ["PENDING", "SENDING", "SENT", "FAILED", "PAUSED", "COMPLETED"] },
        "replyStatus": { "type": "string", "enum": ["NOT_REPLIED", "REPLIED"] },
        "demoStatus": { "type": "string", "enum": ["NOT_BOOKED", "BOOKED"] },
        "demoIntent": { "type": "boolean" },
        "demoSource": { "type": "string", "enum": ["AUTOMATIC", "MANUAL"] },
        "demoBookedAt": { "type": "string" },
        "lastSentAt": { "type": "string" },
        "repliedAt": { "type": "string" },
        "sendCount": { "type": "number" },
        "lastError": { "type": "string", "maxLength": 1024 },
        "gmailMessageId": { "type": "string", "maxLength": 256 },
        "gmailThreadId": { "type": "string", "maxLength": 256 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["campaignLeadId", "campaignId", "email", "sendStatus"]
    },
    "CampaignRun": {
      "title": "CampaignRun",
      "description": "Execution instance tracking history of campaign runs and restarts",
      "type": "object",
      "properties": {
        "runId": { "type": "string", "maxLength": 128 },
        "campaignId": { "type": "string", "maxLength": 128 },
        "runNumber": { "type": "number" },
        "status": { "type": "string", "enum": ["RUNNING", "PAUSED", "COMPLETED", "FAILED"] },
        "templateId": { "type": "string", "maxLength": 128 },
        "totalLeads": { "type": "number" },
        "sentCount": { "type": "number" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["runId", "campaignId", "runNumber", "status"]
    },
    "CampaignSendHistory": {
      "title": "CampaignSendHistory",
      "description": "Send audit log and persistent duplicate protection for cold outreach",
      "type": "object",
      "properties": {
        "historyId": { "type": "string", "maxLength": 128 },
        "campaignId": { "type": "string", "maxLength": 128 },
        "campaignRunId": { "type": "string", "maxLength": 128 },
        "campaignLeadId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "templateId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 512 },
        "gmailMessageId": { "type": "string", "maxLength": 256 },
        "sentAt": { "type": "string" },
        "status": { "type": "string", "enum": ["SENT", "FAILED"] },
        "error": { "type": "string", "maxLength": 512 }
      },
      "required": ["historyId", "campaignId", "email", "sentAt", "status"]
    }
  },
  "firestore": {
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Pilgrimage tour operator contacts"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Tour operator sales leads"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Inbound and outbound omnichannel threads"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages in conversations"
    },
    "/lead_activities/{activityId}": {
      "schema": "LeadActivity",
      "description": "Chronological CRM and lead timeline activities"
    },
    "/processed_inbound_emails/{docId}": {
      "schema": "ProcessedInboundEmail",
      "description": "Persistent cross-restore idempotency ledger preventing duplicate email dispatch"
    },
    "/email_templates/{templateId}": {
      "schema": "EmailTemplate",
      "description": "Predefined cold outreach email templates"
    },
    "/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Outbound prospecting campaigns"
    },
    "/campaign_leads/{campaignLeadId}": {
      "schema": "CampaignLead",
      "description": "Campaign leads uploaded via CSV/XLS/XLSX"
    },
    "/campaign_runs/{runId}": {
      "schema": "CampaignRun",
      "description": "Historical and active run executions per campaign"
    },
    "/campaign_send_history/{historyId}": {
      "schema": "CampaignSendHistory",
      "description": "Cross-restart and cross-session email send ledger ensuring no duplicates"
    }
  }
}
