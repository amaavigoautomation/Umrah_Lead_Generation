{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild src/server/coreApiHandler.ts --bundle --platform=node --format=esm --outfile=api/core-server.bundle.js --external:imapflow --external:mailparser --external:nodemailer",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "check:isolation": "tsx scripts/check-isolation.ts",
    "migrate:dry-run": "tsx scripts/migrate-to-tenants.ts --dry-run",
    "migrate": "tsx scripts/migrate-to-tenants.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.0.5",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.28",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "pino": "^10.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.32.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
