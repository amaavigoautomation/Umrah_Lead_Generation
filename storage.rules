rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isTenantUser(tenantId) {
      return request.auth != null && (
        request.auth.token.platformAdmin == true ||
        request.auth.token.tenantId == tenantId
      );
    }
    match /tenants/{tenantId}/company-assets/{fileName} {
      allow read: if isTenantUser(tenantId);
      allow create, update: if isTenantUser(tenantId)
        && request.resource.size <= 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow delete: if isTenantUser(tenantId);
    }
  }
}
