{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/inbound/whatsapp",
      "destination": "/api/inbound/whatsapp"
    },
    {
      "source": "/api/webhooks/umrah-demo",
      "destination": "/api/webhooks/umrah-demo"
    },
    {
      "source": "/api/leads/inbound",
      "destination": "/api/leads/inbound"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
